pipeline {
    agent any
    
    environment {
        GIT_BRANCH = 'solutions_2025'
        GIT_REPO = 'https://github.com/puneetjhingan/E-Commerce-app'
        SONAR_PROJECT_KEY = 'my-project-key'
        SONAR_HOST_URL = 'http://127.0.0.1:9000'
        SONARQUBE_ENV_NAME = 'sonarserver'
        BRANCH_NAME = "${GIT_BRANCH}"
        DOCKER_IMAGE = 'puneetjhingan/easyshop'
        DOCKER_TAG = "${BUILD_NUMBER}"
        DOCKERHUB_CREDENTIALS = 'dockerhub-creds'
        DOCKERHUB_URL = 'https://index.docker.io/v1/'
        HELM_DIR = 'helm'
        NAMESPACE = 'easyshop'
        }


    stages {

        stage('Checkout Code') {
            agent { label 'linux' }
            steps {
                echo "Checking out branch ${GIT_BRANCH} from ${GIT_REPO}"
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: "${GIT_REPO}",
                        credentialsId: 'github-creds'
                    ]]
                ])
            }
        }

        stage('SonarQube Analysis') {
            agent { label 'test' }
            steps {
                echo 'Running SonarQube analysis'
                withSonarQubeEnv("${SONARQUBE_ENV_NAME}") {
                    sh '''
                    sonar-scanner \
                    -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                    -Dsonar.sources=src \
                    -Dsonar.inclusions=**/*.{ts,tsx,js,jsx} \
                    -Dsonar.exclusions=node_modules/**,.next/**,.db/**,Terraform/**,kubernetes/**,public/**,scripts/**,coverage/**,*.dockerignore,.env,Dockerfile*,README.md,LICENSE,package-lock.json,yarn.lock,postcss.config.js,tailwind.config.ts,next.config.*,docker-compose.yml,ecosystem.config.cjs \
                    -Dsonar.typescript.tsconfigPath=tsconfig.json \
                    -Dsonar.host.url=${SONAR_HOST_URL}
                    '''
                }
            }
        }

        stage('Docker Build') {
            agent { label 'docker' }
            steps {
                echo "Building Docker image ${DOCKER_IMAGE}:${DOCKER_TAG}"
                script {
                    docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                }
            }
        }

        stage('Trivy Scan') {
            agent { label 'docker' }
            steps {
                echo 'Running Trivy vulnerability scan'
                sh "trivy image --severity CRITICAL --exit-code 1 --no-progress ${DOCKER_IMAGE}:${DOCKER_TAG}"
            }
        }

        stage('Push to DockerHub') {
            agent { label 'docker' }
            steps {
                echo "Pushing Docker image ${DOCKER_IMAGE}:${DOCKER_TAG} to DockerHub"
                script {
                    docker.withRegistry("${DOCKERHUB_URL}", "${DOCKERHUB_CREDENTIALS}") {
                        docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}").push()
                    }
                }
            }
        }

        stage('Manual Approval') {
            when {
                expression { return env.BRANCH_NAME == 'solutions_2025' }
            }
            steps {
                input message: 'Manual approval required to deploy to production.', ok: 'Deploy'
            }
        }

        //Option 1 ( Kubernetes Manual Deployment )

//         stage('Kubernetes Apply') {
//             agent { label 'linux' }
