pipeline {
    agent any

    environment {
        GIT_BRANCH = 'solutions_2025'
        GIT_REPO = 'https://github.com/puneetjhingan/E-Commerce-app'
        SONAR_PROJECT_KEY = 'my-project-key'
        SONAR_HOST_URL = 'http://127.0.0.1:9000'
        SONARQUBE_ENV_NAME = 'sonarserver'
        BRANCH_NAME = "${GIT_BRANCH}"

        DOCKER_IMAGE = 'puneetjhingan/easyshop-app'
        DOCKER_TAG = "${BUILD_NUMBER}"
        DOCKERHUB_CREDENTIALS = 'dockerhub-creds'
        DOCKERHUB_URL = 'https://index.docker.io/v1/'
        DEPLOYMENT_NAME = 'easyshop'
        NAMESPACE = 'easyshop'
        IMAGE_NAME = 'puneetjhingan/easyshop:2.0'
        CONTAINER_NAME = 'easyshop'
    }

    stages {
        stage('Checkout Code') {
            agent { label 'linux' }
            steps {
                echo "Pulling code from GitHub branch ${GIT_BRANCH}"
                // git branch: "${GIT_BRANCH}", url: "${GIT_REPO}", credentialsId: 'github-creds'
            }
        }

        stage('SonarQube Analysis') {
            agent { label 'test' }
            steps {
                echo 'Running SonarQube analysis for easy-shop project'
                withSonarQubeEnv("${SONARQUBE_ENV_NAME}") {
                    sh '''
                        sonar-scanner \
                            -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                            -Dsonar.sources=src \
                            -Dsonar.inclusions=**/*.{ts,tsx,js,jsx} \
                            -Dsonar.exclusions=node_modules/**,.next/**,.db/**,Terraform/**,kubernetes/**,public/**,scripts/**,coverage/**,*.dockerignore,.env,Dockerfile*,README.md,LICENSE,package-lock.json,yarn.lock,postcss.config.js,tailwind.config.ts,next.config.*,docker-compose.yml,ecosystem.config.cjs \
                            -Dsonar.typescript.tsconfigPath=tsconfig.json \
                            -Dsonar.host.url=${SONAR_HOST_URL} > sonar.log 2>&1
                    '''
                }
            }
        }

        stage('Docker Build') {
            agent { label 'docker' }
            steps {
                echo 'Building Docker image'
                script {
                    docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                }
            }
        }

        stage('Trivy Scan') {
            agent { label 'docker' }
            steps {
                echo 'Running Trivy vulnerability scan'
                sh "trivy image --severity CRITICAL --exit-code 1 --no-progress ${DOCKER_IMAGE}:${DOCKER_TAG} > trivy.log 2>&1"
            }
        }

        stage('Push to DockerHub') {
            agent { label 'docker' }
            steps {
                echo 'Pushing Docker image to DockerHub'
                script {
                    docker.withRegistry("${DOCKERHUB_URL}", "${DOCKERHUB_CREDENTIALS}") {
                        docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}").push()
                    }
                    echo "Docker image ${DOCKER_IMAGE}:${DOCKER_TAG} pushed successfully"
                }
            }
        }

        stage('Deploy to Production') {
            when {
                branch 'solutions_2025'
            }
            steps {
                echo 'Moving to manual approval stage...'
            }
        }

        stage('Manual Approval') {
            when {
                expression { return env.BRANCH_NAME == 'solutions_2025' }
            }
            steps {
                script {
                    input message: 'Manual approval required to deploy to production.', ok: 'Deploy'
                }
            }
        }

        stage('Deploy to Production') {
            when {
                branch 'solutions_2025'
            }
            steps {
                echo 'Moving to manual approval stage...'
            }
        }

        stage('Manual Approval') {
            when {
                expression { return env.BRANCH_NAME == 'solutions_2025' }
            }
            steps {
                script {
                    input message: 'Manual approval required to deploy to production.', ok: 'Deploy'
                    }
                }
            }
    
        stage('kubernetes') {
            agent { label 'linux' }
            steps {
                echo 'Deploying all Kubernetes manifests...'
                sh '''
                kubectl apply -f 01-namespace.yml
                kubectl apply -f 02-mongodb-pv.yml
                kubectl apply -f 03-mongodb-pvc.yml
                kubectl apply -f 04-configmap.yml
                kubectl apply -f 05-secrets.yml
                kubectl apply -f 06-mongodb-service.yml
                kubectl apply -f 07-mongodb-statefulset.yml
                kubectl apply -f 08-easyshop-deployment.yml
                kubectl apply -f 09-easyshop-service.yml
                kubectl apply -f 10-ingress.yml
                kubectl apply -f 11-hpa.yml
                kubectl apply -f 12-migration-job.yml
                '''
            }
        }
        
        stage('Decide Rollout or Rollback') {
            steps {
                script {
                    // Get rollout history output
                    def rolloutHistory = sh(
                        script: "kubectl rollout history deployment/${DEPLOYMENT_NAME} -n ${NAMESPACE}",
                        returnStdout: true
                    ).trim()

                    echo "Rollout history:\n${rolloutHistory}"

                    if (rolloutHistory?.contains("REVISION")) {
                        echo "Revision(s) found. Performing rollback to last revision."
                        sh """
                            kubectl rollout undo deployment/${DEPLOYMENT_NAME} -n ${NAMESPACE}
                            kubectl rollout status deployment/${DEPLOYMENT_NAME} -n ${NAMESPACE} --timeout=120s
                        """
                    } else {
                        echo "No revision history found. Updating deployment image and rolling out."
                        sh """
                            kubectl set image deployment/ ${CONTAINER_NAME}=${IMAGE_NAME} -n ${NAMESPACE}
                            kubectl set image deployment/${DEPLOYMENT_NAME}r=-n easyshop

                            kubectl rollout status deployment/${DEPLOYMENT_NAME} -n ${NAMESPACE} --timeout=120s
                        """
                    }
                }
            }
        }
    }
}
