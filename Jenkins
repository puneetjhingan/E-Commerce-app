             //option 3 ( ArgoCD Deployment  takeover)

        stage('Update Helm Tag and Push') {
            agent { label 'linux' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                    script {
                        sh """
                        git config user.name "ci-bot"
                        git config user.email "ci-bot@yourorg.com"

                        sed -i 's|tag:.*|tag: "${DOCKER_TAG}"|' helm/values.yaml

                        git add helm/values.yaml
                        git commit -m "Update Docker image tag to ${DOCKER_TAG}"
                        git push https://${GIT_USER}:${GIT_PASS}@github.com/puneetjhingan/E-Commerce-app.git ${GIT_BRANCH}
                    """
                }
            }
        }
