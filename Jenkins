@Library('shared-library')

pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            agent { label 'linux' }  
            steps {
                echo 'Pulling code from GitHub branch'
                git branch: 'soultions_2025', url: "${GITHUB_REPO}"
            }
        }

        stage('SonarQube Analysis') {
            agent { label 'test' }
            steps {
                echo 'Running SonarQube analysis for Node.js project'
                withSonarQubeEnv("${SONARQUBE_ENV}") {
                    sh """
                        ${SONAR_SCANNER}/bin/sonar-scanner \
                        -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                        -Dsonar.sources=. \
                        -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                        -Dsonar.sourceEncoding=UTF-8
                    """
                }
            }
        }
    }
}

